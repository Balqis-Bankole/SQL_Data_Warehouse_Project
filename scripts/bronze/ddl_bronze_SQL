CREATE TABLE IF NOT EXISTS bronze.crm_cust_info (
    cst_id INT,
    cst_key	VARCHAR(15),
    cst_firstname VARCHAR(20),
    cst_lastname VARCHAR(20),  
    cst_marital_status VARCHAR(10),
    cst_gndr VARCHAR(20),
    cst_create_date DATE 
);
   
CREATE TABLE IF NOT EXISTS bronze.crm_prd_info (
    prd_id	INT,
    prd_key	VARCHAR(30),
    prd_nm VARCHAR(50),
    prd_cost INT,
    prd_line VARCHAR(10),
    prd_start_dt DATE,
    prd_end_dt DATE
);

CREATE TABLE IF NOT EXISTS bronze.crm_sales_details (
    sls_ord_num VARCHAR(15),
    sls_prd_key VARCHAR(30),
    sls_cust_id INT,
    sls_order_dt INT,
    sls_ship_dt	INT,
    sls_due_dt INT,
    sls_sales INT,
    sls_quantity INT,
    sls_price INT
);

CREATE TABLE IF NOT EXISTS bronze.erp_cust_az12(
    cid VARCHAR(20),
    bdate VARCHAR(15),
    gen VARCHAR(15)
);

CREATE TABLE IF NOT EXISTS bronze.erp_loc_a101(
    cid VARCHAR(20),
    cntry VARCHAR(15)
);

CREATE TABLE IF NOT EXISTS bronze.erp_px_cat_g1v2(
    id VARCHAR(20),
    cat	VARCHAR(30),
    subcat VARCHAR(30),
    maintenance BOOLEAN
);

